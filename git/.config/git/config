[alias]
    lg = log --graph --pretty=format:'%C(magenta)%h %C(white) %an  %ar%C(auto)  %D%n%s%n'

[color "branch"]
    current = magenta
    local = default
    plain = blue
    remote = yellow
    upstream = green

[core]
    editor = nvim -f
    excludesfile = /Users/alexhughes/.config/git/ignore

[diff "jupyternotebook"]
    command = git-nbdiffdriver diff --ignore-outputs --ignore-metadata --ignore-details

[difftool "nbdime"]
    cmd = git-nbdifftool diff "$LOCAL" "$REMOTE" "$BASE"
    prompt = false

[filter "nbstripout"]
    clean = \"/Users/alexhughes/.local/pipx/venvs/nbstripout/bin/python\" -m nbstripout
    required = true
    smudge = cat

[init]
    defaultbranch = main

[log]
    abbrevcommit = true
    graphcolors = blue,yellow,cyan,magenta,green,red

[merge]
    conflictStyle = zdiff3

[merge "jupyternotebook"]
    driver = git-nbmergedriver merge %O %A %B %L %P
    name = jupyter notebook merge driver

[mergetool "nbdime"]
    cmd = git-nbmergetool merge "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
    prompt = false

[pull]
    rebase = true

[push]
    autosetupremote = true
    default = upstream

[status]
    branch = true
    short = true
    showstash = true

[user]
    email = alex.w.h52@gmail.com
    name = AWH1122

[rebase]
    autoStash = true
    updateRefs = true

[diff]
    algorithm = histogram
    colorMoved = zebra
    mnemonicprefix = true
    renames = copy

[rerere]
    enabled = true

[fetch]
    prune = true
    pruneTags = true
